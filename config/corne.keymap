#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };


        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "DEF";

                        bindings = <
   &kp ESC   &kp Q &kp W        &kp E         &kp R         &kp T          &kp Y      &kp U         &kp I        &kp O        &kp P      &kp BSPC
   &kp TAB   &kp A &hml LALT S  &hml LGUI D   &hml LCTRL F  &kp G          &kp H      &hmr RCTRL J  &hmr RGUI K  &hmr RALT L  &kp SEMI   &kp SQT
   &kp MINUS &kp Z &kp X        &kp C         &kp V         &kp B          &kp N      &kp M         &kp COMMA    &kp DOT      &kp FSLH   &kp ENT
                                &tog 3        &mo 2         &kp LSHFT      &kp SPACE  &mo 1         &trans
                        >;
                };
                lower_layer {
                        display-name = "BRAK_NAV";
                        bindings = <
&trans  &kp LESS_THAN     &kp GREATER_THAN             &kp LEFT_PARENTHESIS       &kp RIGHT_PARENTHESIS          &kp ASTERISK              &trans  &kp HOME  &kp UP    &kp END    &trans  &kp DEL
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET            &kp LEFT_BRACE             &kp RIGHT_BRACE                &kp MINUS                 &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans            &trans                       &kp PLUS                   &kp EQUAL                      &kp UNDER                 &trans  &trans    &trans    &trans     &trans  &trans
                                                       &trans                     &trans                         &trans                    &trans  &trans    &trans

                        >;
                };

                raise_layer {
                        display-name = "NUMBER";
                        bindings = <
&kp TILDE  &kp EXCL  &kp AT_SIGN   &kp POUND     &kp DOLLAR     &kp PERCENT          &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DEL
&kp GRAVE  &kp N1    &hml LALT N2  &hml LGUI N3  &hml LCTRL N4  &kp N5               &kp N6     &hmr RCTRL N7  &hmr RGUI N8  &hmr RALT N9          &kp N0                 &kp PIPE
&trans     &trans    &trans        &trans        &kp EQUAL      &kp PLUS             &kp UNDER  &kp MINUS      &trans        &trans                &trans                 &kp BACKSLASH
                                   &trans        &trans         &trans               &trans     &trans         &trans
                        >;
                };

                game_layer {
                        display-name = "GAME";
                        bindings = <
        &kp ESC   &kp N1 &kp N2   &kp N3  &kp N4    &kp N5           &trans &trans &trans &trans &trans &trans
        &kp TAB   &kp N6 &kp N7   &kp N8  &kp N9    &kp N0           &trans &trans &trans &trans &trans &trans
        &kp SHIFT &kp LT &kp PLUS &kp DOT &kp MINUS &kp GT           &trans &trans &trans &trans &trans &trans
                                &tog 3 &mo 4        &kp SPACE        &trans &trans &trans
                        >;
                };

                move_layer {
                        display-name = "GAME2";
                        bindings = <
        &kp ESC   &kp LEFT_BRACE   &kp LEFT_BRACKET   &kp UP       &kp RIGHT_BRACKET  &kp RIGHT_BRAC      &trans &trans &trans &trans &trans &trans
        &kp TAB   &kp KP_PLUS      &kp LEFT           &kp DOWN     &kp RIGHT          &kp KP_MINUS        &trans &trans &trans &trans &trans &trans
        &kp SHIFT &kp KP_MULTIPLY  &kp KP_SLASH       &kp KP_EQUAL &kp KP_COMMA       &kp KP_DOT          &trans &trans &trans &trans &trans &trans
                                                      &tog 3       &mo 4              &kp SPACE           &trans &trans &trans
                        >;
                };
        };
}